{
  "name": "pygate-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PyGate async worker — verifier queue, webhook delivery, and public v1 verify. Stateless compute service: no Drizzle, no R2 credentials, no schema. All state lives on the dashboard; the worker calls back over HTTP for every read and write.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "jsqr": "^1.4.0",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "zod": "^3.23.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/express": "^5",
    "@types/node": "^20",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "@types/multer": "^1.4.12",
    "vitest": "^2.1.0"
  }
}
