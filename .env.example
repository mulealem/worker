# ============================================================================
# PyGate Worker — environment template
# ============================================================================
# Copy to .env (which is git-ignored) and fill in the values for your
# environment. The worker has no DATABASE_URL and no R2_* — it talks to
# the dashboard for every read and write.
# ============================================================================

# Port the worker's HTTP server listens on. Default 3004 in the Docker
# network; the dashboard's BACKEND_API_URL points at this.
PORT=3004

# URL of the dashboard (where the worker calls claim/result endpoints).
# Inside the Docker compose network:  http://dashboard:3000
# Production (Coolify):             https://dashboard.example.com
DASHBOARD_URL=http://localhost:3000

# Shared bearer token. The dashboard holds the same value in WORKER_API_TOKEN.
# Generate with:  openssl rand -hex 32
# Rotation: append to both allow-lists, deploy, then remove.
WORKER_API_TOKEN=

# ============================================================================
# Provider relays (Ethiopia-hosted proxies for geo-blocked bank APIs)
# ============================================================================
# Telebirr and CBE both get blocked from foreign data centers. Route those
# provider pools through one or more Ethiopia-hosted relays.
#
# Wire format (matches `relayFetchAdapter` in worker/lib/verifier/transport.ts):
#   GET  {RELAY_URL}/{provider}/{urlencode(full upstream URL)}
#   Header: x-relay-key: {RELAY_KEY}
#   Response: 200 + header `x-upstream-status: <real upstream status>` + raw body
#
# Up to 4 slots per provider for redundancy — they are tried in order. Most
# operators only need slot _1. If you point multiple slots at the same host
# they will all share the same circuit breaker, so use distinct hosts.
# ----------------------------------------------------------------------------

# Telebirr relay. The operator's Plesk proxy at payment.com.et works:
TELEBIRR_RELAY_URL_1=https://payment.com.et
TELEBIRR_RELAY_KEY_1=
# TELEBIRR_RELAY_URL_2=
# TELEBIRR_RELAY_KEY_2=
# TELEBIRR_RELAY_URL_3=
# TELEBIRR_RELAY_KEY_3=
# TELEBIRR_RELAY_URL_4=
# TELEBIRR_RELAY_KEY_4=

# CBE relay. Same host as telebirr above (the operator's Plesk proxy serves
# both /telebirr/<url> and /cbe/<url>), but CBE goes relay-ONLY — no direct
# adapter is configured. If CBE_RELAY_URL_1 is unset, every CBE verification
# will fail with an exhausted-pool error.
CBE_RELAY_URL_1=https://payment.com.et
CBE_RELAY_KEY_1=
# CBE_RELAY_URL_2=
# CBE_RELAY_KEY_2=
# CBE_RELAY_URL_3=
# CBE_RELAY_KEY_3=
# CBE_RELAY_URL_4=
# CBE_RELAY_KEY_4=

# Optional: when set, the worker logs every line as JSON; otherwise
# a human-readable format.
# LOG_JSON=1
