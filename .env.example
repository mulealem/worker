# ============================================================================
# Payo Worker — environment template
# ============================================================================
# Copy to .env (which is git-ignored) and fill in the values for your
# environment. The worker has no DATABASE_URL and no R2_* — it talks to
# the dashboard for every read and write.
# ============================================================================

# Port the worker's HTTP server listens on. Default 3004 in the Docker
# network; the dashboard's BACKEND_API_URL points at this.
PORT=3004

# URL of the dashboard (where the worker calls claim/result endpoints).
# Inside the Docker compose network:  http://dashboard:3000
# Production (Coolify):             https://dashboard.example.com
DASHBOARD_URL=http://localhost:3000

# Shared bearer token. The dashboard holds the same value in WORKER_API_TOKEN.
# Generate with:  openssl rand -hex 32
# Rotation: append to both allow-lists, deploy, then remove.
WORKER_API_TOKEN=

# ============================================================================
# Executor knobs (all optional)
# ============================================================================
# Max verifier jobs executed simultaneously. OCR (tesseract + sharp) is
# CPU-heavy; the default of 3 keeps a dispatch burst from thrashing the box.
# WORKER_MAX_CONCURRENCY=3

# Hard wall-clock budget for one verification job, including local retries
# (ms). Past it the job is marked FAILED on the dashboard instead of
# retrying, so payments never sit in "verifying" forever. Default 180000.
# VERIFIER_JOB_DEADLINE_MS=180000

# Liveness heartbeat to the dashboard, in ms. 0 (default) disables it.
# WORKER_HEARTBEAT_MS=10000

# Set to 1 to boot the HTTP server without starting the executor.
# WORKER_DISABLED=0

# ============================================================================
# Provider relays (Ethiopia-hosted proxies for geo-blocked bank APIs)
# ============================================================================
# CBE is relay-ONLY (geo-blocked from the worker host); Telebirr and M-Pesa
# try their direct adapter first and fall back to the relays. All providers
# share ONE pool of interchangeable relays — every relay serves the same
# provider-agnostic endpoint, and requests are round-robined across every
# healthy relay, so adding capacity is a config change, not a code change.
#
# Wire format (matches `relayFetchAdapter` in worker/lib/verifier/transport.ts;
# relay script v0.15+ in aihuck/plesk_nodejs):
#   GET  {relay}/relay/{base64url(full upstream URL)}
#   Header: x-relay-key: {key}
#   Response: 200 + header `x-upstream-status: <real upstream status>` + raw body
#
# Configure the pool one of two ways (RELAYS_FILE wins when both are set):
#
#   1. RELAYS — comma/newline-separated entries, each `url|key`, or just
#      `url` when RELAY_SHARED_KEY is set:
#
#        RELAYS=https://payment.com.et|secret1,https://relay2.et|secret2
#        RELAY_SHARED_KEY=secret
#        RELAYS=https://payment.com.et,https://relay2.et
#
#   2. RELAYS_FILE — path to a JSON file (relative to the worker cwd):
#
#        { "relays": [
#          { "url": "https://payment.com.et", "key": "secret1" },
#          "https://relay2.et|secret2"
#        ] }
#
# The old TELEBIRR_/CBE_/MPESA_RELAY_URL_1..4 variables are no longer read.
# ----------------------------------------------------------------------------


# Optional: when set, the worker logs every line as JSON; otherwise
# a human-readable format.
# LOG_JSON=1
